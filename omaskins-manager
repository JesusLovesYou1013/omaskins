#!/usr/bin/env python3
# omarchy:summary=OmaSkins Manager — browse and manage Omarchy themes, backgrounds and fonts
import os
import sys

# Never write Python's cache into the plugin folder: Omarchy reloads the plugin on any file change there.
sys.dont_write_bytecode = True
os.environ["PYTHONDONTWRITEBYTECODE"] = "1"   # and nothing it starts writes it either


def _in_try_omarchy_vm():
    try:
        with open("/proc/cmdline") as f:
            return "omarchy.qemu=1" in f.read().split()
    except OSError:
        return False


# Try Omarchy VM: Zink (inherited from a terminal that uses it) swaps red and blue, so OmaSkins drops it
# and draws with GTK's OpenGL renderer on virgl, the VM's real GPU. (It drew in software here for a
# while, because virgl garbled tooltips: report 07. Gone with GTK 4.24.1 + Mesa 26.2.5, checked
# 2026-10-28, and software drawing dropped most frames of the big view's animation.) GL, not GTK's own
# pick: its Vulkan choice here is the CPU (lavapipe). An explicit GSK_RENDERER still wins. (Report 04c.)
if _in_try_omarchy_vm():
    os.environ.setdefault("GSK_RENDERER", "gl")
    os.environ.pop("MESA_LOADER_DRIVER_OVERRIDE", None)

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

# Omarchy's font rule turns every monospace font asked for by name into the current font, so OmaSkins
# couldn't show any other font. OmaSkins' own process uses the system font config without that one
# rule (programs it starts get the normal setup back). Must happen before GTK/fontconfig start.
from omaskins import data  # noqa: E402

if "FONTCONFIG_FILE" not in os.environ:
    _conf = data.private_fontconfig()
    if _conf:
        os.environ["FONTCONFIG_FILE"] = str(_conf)
        os.environ["OMASKINS_FONTCONFIG"] = "1"

# OmaSkins' window floats, centred and sized: the rules are set before the window exists (run.py).
from omaskins import run  # noqa: E402

run.ensure_window_rules()
run.data.private_cache()

from omaskins.app import main  # noqa: E402

sys.exit(main())
