#!/bin/bash

# omarchy:summary=OmaSkins' bar menu: next theme or background, or open OmaSkins
#
# Shown in Omarchy's own menu (omarchy-menu-select). "Next" asks OmaSkins' rotation engine, so a skip
# follows the rotation's own lists when it rotates that, and the schedule carries on as before.

dir="$(dirname "$(realpath "$0")")"

choice=$(omarchy-menu-select "OmaSkins" \
  $'󰋩\tNext background' \
  $'󰏘\tNext theme' \
  $'󰏌\tOpen OmaSkins' 2>/dev/null) || exit 0

case "$choice" in
  "Next background") "$dir/omaskins-rotate" next background ;;
  "Next theme") "$dir/omaskins-rotate" next theme ;;
  "Open OmaSkins") setsid -f uwsm-app -- "$dir/omaskins-manager" >/dev/null 2>&1 ;;
esac
